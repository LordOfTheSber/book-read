# Локальная разработка: скопируйте в .env и подставьте свои значения.
#   cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

POSTGRES_DB=library
POSTGRES_USER=library
# Пароль локальной БД. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# Те же данные для бэкенда, запускаемого через `mvn spring-boot:run`.
DB_URL=jdbc:postgresql://localhost:5432/library
DB_USER=library
DB_PASSWORD=
